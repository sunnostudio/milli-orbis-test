; MilliOrbis 海琳あおい Cursor Scheme — Right-click > Install (Admin required)
; Generated by scripts/generate-cursor-packs.py
; Scheme: MilliOrbis-Aoi
; Based on david-ly gist MIT template, adapted for MilliOrbis
[Version]
Signature="$Windows NT$"

[DefaultInstall]
CopyFiles=Cursors.Files
AddReg=Cursors.Reg

[DestinationDirs]
Cursors.Files=10,"%CUR_DIR%"

[Cursors.Files]
appstar.cur
arrow.cur
beam.cur
cross.cur
hand.cur
help.cur
move.cur
no.cur
pen.cur
person.cur
sizenesw.cur
sizens.cur
sizenwse.cur
sizewe.cur
wait.cur

[Cursors.Reg]
HKCU,"Control Panel\Cursors\Schemes","%SCHEME_NAME%","%10%\%CUR_DIR%\%pointer%,%10%\%CUR_DIR%\%help%,%10%\%CUR_DIR%\%work%,%10%\%CUR_DIR%\%busy%,%10%\%CUR_DIR%\%cross%,%10%\%CUR_DIR%\%text%,%10%\%CUR_DIR%\%hand%,%10%\%CUR_DIR%\%unavailable%,%10%\%CUR_DIR%\%vert%,%10%\%CUR_DIR%\%horz%,%10%\%CUR_DIR%\%dgn1%,%10%\%CUR_DIR%\%dgn2%,%10%\%CUR_DIR%\%move%,%10%\%CUR_DIR%\%alternate%,%10%\%CUR_DIR%\%link%,%10%\%CUR_DIR%\%pin%,%10%\%CUR_DIR%\%person%"

[Strings]
CUR_DIR     = "Cursors\MilliOrbis-Aoi"
SCHEME_NAME = "MilliOrbis-Aoi"
pointer     = "arrow.cur"
help        = "help.cur"
work        = "appstar.cur"
busy        = "wait.cur"
cross       = "cross.cur"
text        = "beam.cur"
hand        = "pen.cur"
unavailable = "no.cur"
vert        = "sizens.cur"
horz        = "sizewe.cur"
dgn1        = "sizenwse.cur"
dgn2        = "sizenesw.cur"
move        = "move.cur"
alternate   = "arrow.cur"
link        = "hand.cur"
pin         = "hand.cur"
person      = "person.cur"
